{
  "name": "the-common",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:local": "cross-env USE_LOCAL_D1=true NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "deploy": "pnpm run deploy:database && pnpm run generate:sitemap:prod && pnpm run deploy:app",
    "deploy:app": "opennextjs-cloudflare build --env=$CLOUDFLARE_ENV && opennextjs-cloudflare deploy --env=$CLOUDFLARE_ENV -- --keep-vars",
    "migrate:remote": "cross-env NODE_ENV=production CLOUDFLARE_REMOTE_BINDINGS=true PAYLOAD_SECRET=ignore payload migrate",
    "deploy:database": "pnpm run migrate:remote && wrangler d1 execute D1 --command 'PRAGMA optimize' --env=$CLOUDFLARE_ENV --remote",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "db:clear-locks": "wrangler d1 execute D1 --local --file scripts/db-repair/sql/locks.sql",
    "db:repair-local": "bash scripts/db-repair/repair-local.sh",
    "db:reset-local": "rm -rf .wrangler/state/v3/d1",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "pnpm install --ignore-workspace",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env=$CLOUDFLARE_ENV",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate:events": "cross-env USE_LOCAL_D1=true NODE_OPTIONS=--no-deprecation tsx scripts/migration/migrate-events.ts",
    "migrate:events:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/migration/migrate-events.ts --remote",
    "migrate:events:rollback": "cross-env USE_LOCAL_D1=true NODE_OPTIONS=--no-deprecation tsx scripts/migration/rollback-events.ts",
    "migrate:events:rollback:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/migration/rollback-events.ts --remote",
    "migrate:shops": "cross-env USE_LOCAL_D1=true NODE_OPTIONS=--no-deprecation tsx scripts/migration/migrate-shops.ts",
    "migrate:shops:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/migration/migrate-shops.ts --remote",
    "migrate:shops:cleanup-media": "cross-env USE_LOCAL_D1=true NODE_OPTIONS=--no-deprecation tsx scripts/migration/cleanup-shops-media.ts",
    "migrate:shops:cleanup-media:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/migration/cleanup-shops-media.ts --remote",
    "migrate:blogs": "cross-env USE_LOCAL_D1=true NODE_OPTIONS=--no-deprecation tsx scripts/migration/migrate-blogs.ts",
    "migrate:blogs:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/migration/migrate-blogs.ts --remote",
    "migrate:blogs:rollback": "cross-env USE_LOCAL_D1=true NODE_OPTIONS=--no-deprecation tsx scripts/migration/rollback-blogs.ts",
    "migrate:blogs:rollback:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/migration/rollback-blogs.ts --remote",
    "export:vendors": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migration/export-vendors.ts",
    "generate:sitemap": "cross-env USE_LOCAL_D1=true NODE_OPTIONS=--no-deprecation tsx scripts/generate-sitemap.ts",
    "generate:sitemap:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/generate-sitemap.ts --remote",
    "strip:vendor-slugs": "cross-env USE_LOCAL_D1=true NODE_OPTIONS=--no-deprecation tsx scripts/migration/strip-vendor-branch-slugs.ts",
    "strip:vendor-slugs:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx scripts/migration/strip-vendor-branch-slugs.ts --remote"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "@opennextjs/cloudflare": "^1.11.0",
    "@panzoom/panzoom": "^4.6.2",
    "@payloadcms/db-d1-sqlite": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/plugin-seo": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/storage-r2": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "marked": "^18.0.4",
    "next": "15.4.11",
    "payload": "3.82.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.12.4",
    "swiper": "^12.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "wrangler": "~4.98.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      },
      "RESEND_API_KEY": {
        "description": "Resend API key for contact form emails"
      },
      "RESEND_FROM_EMAIL": {
        "description": "Verified Resend sender, e.g. The Common <noreply@yourdomain.com>"
      },
      "CONTACT_INQUIRY_TO_EMAIL": {
        "description": "Optional fallback recipient if Contact global email is empty"
      },
      "VENUE_RENTAL_INQUIRY_TO_EMAIL": {
        "description": "Recipient for venue rental booking inquiries"
      }
    }
  }
}
