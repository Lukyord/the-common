# A generated secret for Payload
PAYLOAD_SECRET=

# Resend (contact form)
RESEND_API_KEY=
# Sender — must NOT be @gmail.com. Use Resend test sender locally, or your verified domain in production:
#   Dev:  RESEND_FROM_EMAIL=onboarding@resend.dev
#   Prod: RESEND_FROM_EMAIL=The Common <noreply@thecommonsbkk.com>
# Without a verified domain, Resend only delivers to the email you signed up with.
RESEND_FROM_EMAIL=
# For `pnpm preview` / Wrangler, copy these into `.dev.vars` (same keys). On Cloudflare, set as Worker secrets.
# Optional fallback recipient if Contact global has no email
CONTACT_INQUIRY_TO_EMAIL=
# Vendor email for venue rental inquiries
VENUE_RENTAL_INQUIRY_TO_EMAIL=
# On Cloudflare: set RESEND_API_KEY as a Secret; the rest can be plain Variables.

# Google Analytics (loaded only after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL (robots.txt, sitemap, Open Graph)
# Prod: NEXT_PUBLIC_SITE_URL=https://www.thecommonsbkk.com
NEXT_PUBLIC_SITE_URL=
